# ───────── Large generated tile artifacts ─────────
# The bundled ghatshila.pmtiles is committed via assets/ intentionally;
# raw/intermediate OSM extracts produced by tool/generate_tiles.sh are not.
tool/*.osm.pbf
tool/*.tmp
*.osm.pbf

