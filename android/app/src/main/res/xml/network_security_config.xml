<?xml version="1.0" encoding="utf-8"?>
<!--
  The app renders its offline map from an in-process HTTP server bound to
  127.0.0.1 (see LocalTileServer). Android 9+ (API 28+) blocks cleartext HTTP
  by default, which would prevent MapLibre from loading the style/tiles/glyphs
  and leave the map blank. We keep the secure default for all real domains and
  permit cleartext ONLY for the loopback addresses the local tile server uses.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
